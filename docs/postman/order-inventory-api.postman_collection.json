{
  "info": {
    "name": "Order & Inventory API",
    "description": "Requests covering the Category, Product, and Order endpoints, including stock-adjustment, low-stock, order-status-transition, pagination, and role-based authorization, plus a few deliberate error cases exercising the global exception handler. Catalog/fulfillment writes use the admin credentials at the collection level; placing an order overrides to the customer credentials, since that only needs any authenticated user. Fill in adminPassword/customerPassword with whatever you set ADMIN_PASSWORD/CUSTOMER_PASSWORD to when starting the app — nothing is pre-filled here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{adminUsername}}" },
      { "key": "password", "value": "{{adminPassword}}" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "" },
    { "key": "customerUsername", "value": "customer" },
    { "key": "customerPassword", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronics and accessories\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?page=0&size=20&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "id,asc" }
              ]
            }
          }
        },
        {
          "name": "Get Category by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"2.4GHz wireless mouse\",\n  \"sku\": \"WM-1001\",\n  \"price\": 19.99,\n  \"stockQuantity\": 150,\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=0&size=20&sort=price,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "price,desc" }
              ]
            }
          }
        },
        {
          "name": "List Products by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?categoryId={{categoryId}}&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Product by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"2.4GHz wireless mouse, updated\",\n  \"sku\": \"WM-1001\",\n  \"price\": 17.99,\n  \"stockQuantity\": 150,\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Adjust Stock (increase)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 25\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/stock"
          }
        },
        {
          "name": "Adjust Stock (decrease)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": -10\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/stock"
          }
        },
        {
          "name": "Get Low Stock Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/low-stock?threshold=10"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerUsername}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"jane@example.com\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 3 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Placing an order only requires being logged in — the customer account (not the admin one) is used here on purpose."
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Get Order by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "Update Order Status (Confirm)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Update Order Status (Cancel)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Create Product - Duplicate SKU (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Duplicate\",\n  \"description\": \"Should fail on SKU uniqueness\",\n  \"sku\": \"WM-1001\",\n  \"price\": 19.99,\n  \"stockQuantity\": 10,\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Create Product - Validation Failure (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"sku\": \"\",\n  \"price\": -5,\n  \"stockQuantity\": -1\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Get Product - Not Found (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/999999"
          }
        },
        {
          "name": "Create Order - Insufficient Stock (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"jane@example.com\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 999999 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "Update Order Status - Invalid Transition (409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status",
            "description": "Expected to fail once the order has already moved to SHIPPED or CANCELLED — those states have no allowed outgoing transitions."
          }
        },
        {
          "name": "Create Category - Unauthorized (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories",
            "description": "No credentials supplied — write endpoints require ADMIN authentication."
          }
        },
        {
          "name": "Create Order - Unauthorized (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"jane@example.com\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "No credentials supplied — placing an order requires being logged in, even though browsing the catalog doesn't."
          }
        },
        {
          "name": "Update Order Status - Forbidden as Customer (403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerUsername}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status",
            "description": "The customer who placed an order can't push it through fulfillment themselves — status changes are staff-only (ADMIN role)."
          }
        }
      ]
    },
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "App Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/info"
          }
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/metrics"
          }
        }
      ]
    }
  ]
}
