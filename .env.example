# Copy this file to .env and fill in your own values. .env is gitignored — never commit real
# credentials. These are consumed by docker-compose.yml.

DB_NAME=order_inventory_db
DB_USERNAME=order_inventory_app
DB_PASSWORD=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CUSTOMER_USERNAME=customer
CUSTOMER_PASSWORD=

# Optional — sensible defaults are used if omitted
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
